@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(WIN32)
  find_package(Threads REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/PathAuthorityTargets.cmake")

# Fail fast when the documented package surface is not actually exported.
if(NOT TARGET SummonSoftwareLabs::PathAuthority)
  set(PathAuthority_FOUND FALSE)
  set(PathAuthority_NOT_FOUND_MESSAGE
      "PathAuthority package did not export the SummonSoftwareLabs::PathAuthority target")
  return()
endif()

set(PathAuthority_LIBRARIES SummonSoftwareLabs::PathAuthority)
set(PathAuthority_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")

check_required_components(PathAuthority)
